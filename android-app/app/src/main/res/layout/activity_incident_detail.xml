<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/banner" style="@style/Banner" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card_normal" android:paddingStart="20dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="14dp">
            <TextView android:id="@+id/state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/pill"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="3dp" android:paddingBottom="3dp" android:textStyle="bold" android:textSize="14sp"/>
            <TextView android:id="@+id/title" style="@style/H1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
            <TextView android:id="@+id/sub" style="@style/Muted" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Company actions -->
        <LinearLayout android:id="@+id/companyActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <com.google.android.material.button.MaterialButton android:id="@+id/ackBtn" style="@style/BigButton" android:text="✔ Mark incident as acknowledged"
                android:backgroundTint="@color/red" android:textColor="@color/white"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/callRiderBtn" style="@style/BigButton.Outlined" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp" android:text="📞 Call rider"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/callContactBtn" style="@style/BigButton.Outlined" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_marginStart="6dp" android:text="📞 Call contact"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/closeBtn" style="@style/BigButton.Outlined" android:text="Close incident…"/>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Location"/>
                <TextView android:id="@+id/location" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <org.osmdroid.views.MapView android:id="@+id/map" android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="8dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/directionsBtn" style="@style/BigButton.Outlined" android:text="Directions (Google Maps)"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:id="@+id/peopleCard" style="@style/Card" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rider, contact and health"/>
                <TextView android:id="@+id/people" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alerts and timeline"/>
                <TextView android:id="@+id/alerts" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sensor summary"/>
                <TextView android:id="@+id/sensors" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Card">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/H2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accident video"/>
                <TextView android:id="@+id/frontStatus" style="@style/Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/frontBtn" style="@style/BigButton.Outlined" android:text="▶ Play video"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton android:id="@+id/deleteBtn" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="Request deletion of this record" android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
