<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/navy">
    <TextView android:id="@+id/banner" style="@style/Banner" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:gravity="center" android:padding="28dp">
        <ImageView android:layout_width="128dp" android:layout_height="128dp" android:src="@drawable/logo" android:contentDescription="RideGuard logo"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RideGuard" android:textColor="@color/white"
            android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="14dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
            android:text="Ride safe. If something happens,\nhelp is alerted fast." android:textColor="#B8C4DA" android:textSize="18sp" android:layout_marginBottom="36dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/riderBtn" style="@style/BigButton" android:text="Rider login"
            android:backgroundTint="@color/white" android:textColor="@color/ink"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/companyBtn" style="@style/BigButton" android:text="Company login"
            android:backgroundTint="@color/navy2" app:strokeColor="#44587A" app:strokeWidth="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/helpBtn" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp"
            android:text="Help and about" android:textColor="#DFE6F1" android:textSize="16sp"/>
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="12dp"/>
    </LinearLayout>
</LinearLayout>
