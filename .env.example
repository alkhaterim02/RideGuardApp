# Raspberry Pi vest (copy to .env, never commit real values)
RIDEGUARD_DEVICE_ID=vest-001
RIDEGUARD_BACKEND_URL=https://REGION-PROJECT_ID.cloudfunctions.net/api
RIDEGUARD_DEVICE_SECRET=CHANGE_ME_PROVISIONED_PER_DEVICE
RIDEGUARD_MODEM_PORT=/dev/ttyUSB2
RIDEGUARD_MODEM_BAUD=115200
RIDEGUARD_DEMO_MODE=1   # 1 = mock hardware, SMS never sent
